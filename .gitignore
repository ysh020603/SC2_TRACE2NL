# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/

# Runtime logs
logs/*
!logs/.gitkeep

# Replay binaries (keep directory README / .gitkeep)
**/*.SC2Replay
**/*.sc2replay

# Generated parse artifacts (keep README / .gitkeep)
data/artifacts/**/*.parquet
data/artifacts/**/*.json
data/artifacts/**/*.jsonl
data/artifacts/**/*.md
!data/artifacts/**/README.md
!data/artifacts/**/.gitkeep

# Generated full match JSON (keep README / .gitkeep)
data/full_json/**/*.json
!data/full_json/**/README.md
!data/full_json/**/.gitkeep

# Generated command-derived macro JSON
data/action_json/**/*.json
data/action_json/**/*.jsonl
!data/action_json/**/README.md
!data/action_json/**/.gitkeep

# Pending replay folders keep structure only
data/replays/**/*
!data/replays/**/
!data/replays/**/README.md
!data/replays/**/.gitkeep
!data/replays/README.md

# Raw Blizzard replay extract:
# - ignore all binaries / staging / logs under raw_data
# - keep directory skeleton, README, docs, and manifest.json
raw_data/**
!raw_data/
!raw_data/README.md
!raw_data/manifest.json
!raw_data/docs/
!raw_data/docs/**
!raw_data/by_matchup/
!raw_data/by_matchup/*/
!raw_data/by_matchup/*/.gitkeep
!raw_data/logs/
!raw_data/logs/.gitkeep
raw_data/_staging/

# Archive payloads (keep README / .gitkeep)
archive/local_ai_logs/**/*
!archive/local_ai_logs/**/
!archive/local_ai_logs/**/README.md
!archive/local_ai_logs/**/.gitkeep
!archive/local_ai_logs/README.md

# Vendor clones
vendor/sc2reader/
vendor/s2protocol/
vendor/DI-star/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Secrets / local
.env
*.local.yaml

# LLM API keys (keep example only; copy to config.json locally)
API_config/config.json

# Analysis generated data (keep scripts + README / .gitkeep)
analysis/outputs/**
!analysis/outputs/
!analysis/outputs/README.md
!analysis/outputs/.gitkeep
analysis/outputs_skill_v2/**
!analysis/outputs_skill_v2/
!analysis/outputs_skill_v2/README.md
!analysis/outputs_skill_v2/.gitkeep
# Pre-V2 generated outputs are archived locally but remain too large for Git.
archive/pre_v2/analysis/outputs/**
!archive/pre_v2/analysis/outputs/
!archive/pre_v2/analysis/outputs/README.md
!archive/pre_v2/analysis/outputs/.gitkeep
archive/v2_runs/**
analysis/full_parse/logs/**
!analysis/full_parse/logs/
!analysis/full_parse/logs/.gitkeep
analysis/full_parse/state/**
!analysis/full_parse/state/
!analysis/full_parse/state/.gitkeep
